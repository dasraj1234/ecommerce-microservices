# The frontend talks to the backend via RELATIVE paths (e.g. /auth/login).
# In dev, the Vite proxy (vite.config.js) routes each prefix to the right
# service port (auth :8081, product/order :8082, payment/wallet :8083).
#
# Leave VITE_API_URL unset/empty to use relative paths (recommended).
# Set it ONLY to bypass the proxy and hit a single backend origin directly,
# e.g. the API gateway: VITE_API_URL=http://localhost:8080
# VITE_API_URL=
